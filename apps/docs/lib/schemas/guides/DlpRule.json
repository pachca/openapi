{
  "title": "Структура правила DLP",
  "schema": {
    "type": "object",
    "required": ["conditions", "action"],
    "properties": {
      "scope": {
        "type": "object",
        "description": "Объект контекста применения правила",
        "properties": {
          "to_external": {
            "type": "boolean",
            "description": "Ограничение по наличию внешних контактов в чате. При значении true правило работает только в чатах, где есть гости или мульти-гости, а при значении false только в чатах без них. Если поле не указано, по этому признаку правило не ограничивается."
          },
          "channel_type": {
            "description": "Тип чата, в котором работает правило. Одно значение строкой или непустой массив без повторов: с массивом правило работает в чатах любого из перечисленных типов.",
            "enum": ["personal", "discussion", "channel", "thread"],
            "x-enum-descriptions": {
              "personal": "личные сообщения",
              "discussion": "беседы",
              "channel": "каналы",
              "thread": "треды"
            },
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            ]
          },
          "user_role": {
            "description": "Роль автора сообщения в чате, при которой работает правило. Одно значение строкой или непустой массив без повторов: с массивом правило работает при любой из перечисленных ролей.",
            "enum": ["owner", "admin", "editor", "member", "subscriber", "not_member"],
            "x-enum-descriptions": {
              "owner": "создатель",
              "admin": "админ",
              "editor": "редактор",
              "member": "участник (для бесед)",
              "subscriber": "подписчик (для каналов)",
              "not_member": "не состоит в чате"
            },
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            ]
          }
        }
      },
      "conditions": {
        "type": "object",
        "description": "Объект условия срабатывания правила. Нужно указать all, any или оба, и тогда должны выполниться оба.",
        "properties": {
          "all": {
            "type": "array",
            "description": "Массив условий (все должны совпасть)",
            "minItems": 1,
            "items": {
              "type": "object",
              "oneOf": [
                {
                  "title": "Регулярное выражение",
                  "type": "object",
                  "required": ["type", "pattern"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "description": "Тип условия",
                      "enum": ["regex"]
                    },
                    "pattern": {
                      "type": "string",
                      "description": "Регулярное выражение для поиска в тексте, в синтаксисе Ruby",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "min_hits": {
                      "type": "integer",
                      "description": "Минимальное количество совпадений",
                      "default": 1,
                      "minimum": 1
                    },
                    "max_hits": {
                      "type": "integer",
                      "description": "Максимальное количество совпадений",
                      "minimum": 1
                    }
                  }
                },
                {
                  "title": "Ключевое слово",
                  "type": "object",
                  "required": ["type", "value"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "description": "Тип условия",
                      "enum": ["keyword"]
                    },
                    "value": {
                      "type": "string",
                      "description": "Ключевое слово для поиска в тексте"
                    },
                    "min_hits": {
                      "type": "integer",
                      "description": "Минимальное количество совпадений",
                      "default": 1,
                      "minimum": 1
                    },
                    "max_hits": {
                      "type": "integer",
                      "description": "Максимальное количество совпадений",
                      "minimum": 1
                    }
                  }
                },
                {
                  "title": "Вложенная группа",
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 1,
                  "additionalProperties": false,
                  "description": "Объект ровно с одним ключом: all или any. Элементы его массива устроены так же, как элементы этого массива, и тоже могут быть вложенными группами.",
                  "properties": {
                    "all": {
                      "type": "array",
                      "description": "Массив условий (все должны совпасть)",
                      "minItems": 1,
                      "items": {
                        "type": "object"
                      }
                    },
                    "any": {
                      "type": "array",
                      "description": "Массив условий (хотя бы одно должно совпасть)",
                      "minItems": 1,
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              ]
            }
          },
          "any": {
            "type": "array",
            "description": "Массив условий (хотя бы одно должно совпасть)",
            "minItems": 1,
            "items": {
              "type": "object",
              "oneOf": [
                {
                  "title": "Регулярное выражение",
                  "type": "object",
                  "required": ["type", "pattern"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "description": "Тип условия",
                      "enum": ["regex"]
                    },
                    "pattern": {
                      "type": "string",
                      "description": "Регулярное выражение для поиска в тексте, в синтаксисе Ruby",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "min_hits": {
                      "type": "integer",
                      "description": "Минимальное количество совпадений",
                      "default": 1,
                      "minimum": 1
                    },
                    "max_hits": {
                      "type": "integer",
                      "description": "Максимальное количество совпадений",
                      "minimum": 1
                    }
                  }
                },
                {
                  "title": "Ключевое слово",
                  "type": "object",
                  "required": ["type", "value"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "description": "Тип условия",
                      "enum": ["keyword"]
                    },
                    "value": {
                      "type": "string",
                      "description": "Ключевое слово для поиска в тексте"
                    },
                    "min_hits": {
                      "type": "integer",
                      "description": "Минимальное количество совпадений",
                      "default": 1,
                      "minimum": 1
                    },
                    "max_hits": {
                      "type": "integer",
                      "description": "Максимальное количество совпадений",
                      "minimum": 1
                    }
                  }
                },
                {
                  "title": "Вложенная группа",
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 1,
                  "additionalProperties": false,
                  "description": "Объект ровно с одним ключом: all или any. Элементы его массива устроены так же, как элементы этого массива, и тоже могут быть вложенными группами.",
                  "properties": {
                    "all": {
                      "type": "array",
                      "description": "Массив условий (все должны совпасть)",
                      "minItems": 1,
                      "items": {
                        "type": "object"
                      }
                    },
                    "any": {
                      "type": "array",
                      "description": "Массив условий (хотя бы одно должно совпасть)",
                      "minItems": 1,
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "action": {
        "type": "object",
        "description": "Объект действия при срабатывании правила",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "description": "Тип действия",
            "enum": ["BLOCK", "AUDIT_LOG", "BLOCK_AND_AUDIT_LOG"],
            "x-enum-descriptions": {
              "BLOCK": "удалить текст сообщения",
              "AUDIT_LOG": "добавить запись в журнал событий",
              "BLOCK_AND_AUDIT_LOG": "удалить текст сообщения и добавить запись в журнал событий"
            }
          },
          "message": {
            "type": "string",
            "description": "Текст сообщения для пользователя",
            "example": "Сообщение заблокировано политикой безопасности"
          }
        }
      }
    }
  }
}
