{
  "title": "Структура данных в JSON-файлах сообщений",
  "schema": {
    "type": "object",
    "properties": {
      "id": { "type": "integer", "description": "Идентификатор сообщения", "example": 12345 },
      "created_at": {
        "type": "string",
        "format": "date-time",
        "description": "Дата и время создания сообщения (ISO-8601, UTC+0)",
        "example": "2024-01-15T10:30:00.000Z"
      },
      "deleted_at": {
        "type": "string",
        "format": "date-time",
        "nullable": true,
        "description": "Дата и время удаления сообщения. Возвращается как null, если сообщение не удалено."
      },
      "content": {
        "type": "string",
        "description": "Текст сообщения. В личных переписках вместо текста приходит `-`, если поддержка Пачки не включила для пространства их полную выгрузку.",
        "example": "Привет! Как дела?"
      },
      "thread_id": {
        "type": "integer",
        "nullable": true,
        "description": "Идентификатор треда сообщения. Возвращается как null, если у сообщения нет комментариев."
      },
      "reactions": {
        "type": "array",
        "description": "Массив списка реакций",
        "items": {
          "type": "object",
          "properties": {
            "user_id": {
              "type": "integer",
              "description": "Идентификатор пользователя, который добавил реакцию"
            },
            "created_at": {
              "type": "string",
              "description": "Дата и время добавления реакции (ISO-8601, UTC+0)"
            },
            "code": { "type": "string", "description": "Emoji символ реакции", "example": "👍" }
          }
        }
      },
      "user": {
        "type": "object",
        "description": "Информация об авторе сообщения",
        "properties": {
          "id": { "type": "integer", "description": "Идентификатор пользователя" },
          "role": {
            "type": "string",
            "description": "Тип автора",
            "enum": ["member", "bot"],
            "x-enum-descriptions": { "member": "пользователь", "bot": "бот" }
          },
          "name": { "type": "string", "description": "Имя" },
          "last_name": { "type": "string", "description": "Фамилия" },
          "email": { "type": "string", "description": "Электронная почта" },
          "tags": {
            "type": "array",
            "description": "Массив тегов, привязанных к пользователю",
            "items": { "type": "string" }
          }
        }
      },
      "chat": {
        "type": "object",
        "description": "Информация о чате, в котором было написано сообщение",
        "properties": {
          "id": { "type": "integer", "description": "Идентификатор чата" },
          "name": { "type": "string", "description": "Название чата" },
          "personal": {
            "type": "boolean",
            "description": "Тип чата",
            "enum": [true, false],
            "x-enum-descriptions": { "true": "личный чат", "false": "групповой чат" }
          },
          "owner": {
            "type": "object",
            "description": "Информация о владельце чата",
            "properties": {
              "id": { "type": "integer", "description": "Идентификатор пользователя" },
              "role": {
                "type": "string",
                "description": "Тип владельца",
                "enum": ["member", "bot"],
                "x-enum-descriptions": { "member": "пользователь", "bot": "бот" }
              },
              "name": { "type": "string", "description": "Имя" },
              "last_name": { "type": "string", "description": "Фамилия" },
              "email": { "type": "string", "description": "Электронная почта" },
              "tags": {
                "type": "array",
                "description": "Массив тегов",
                "items": { "type": "string" }
              }
            }
          },
          "tags": {
            "type": "array",
            "description": "Массив тегов, привязанных к чату",
            "items": { "type": "string" }
          }
        }
      },
      "thread": {
        "type": "object",
        "nullable": true,
        "description": "Тред, в котором находится сообщение. Возвращается как null, если сообщение находится не в треде.",
        "properties": {
          "id": { "type": "integer", "description": "Идентификатор треда" },
          "message_id": {
            "type": "integer",
            "description": "Идентификатор сообщения, под которым был начат тред"
          },
          "message_chat_id": {
            "type": "string",
            "description": "Идентификатор чата, в котором был начат тред"
          }
        }
      }
    }
  }
}
