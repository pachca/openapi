        },
        "options": {}
      },
      "name": "Тип события",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [220, 200]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "create",
        "entityId": {
          "__rl": true,
          "value": "={{ $json.chat_id }}",
          "mode": "id"
        },
        "content": "Нажмите кнопку, чтобы оформить заявку на отпуск:",
        "buttonLayout": "raw_json",
        "rawJsonButtons": "[[{\"text\":\"Создать заявку\",\"data\":\"vacation_request\"}]]"
      },
      "name": "Кнопка заявки",
      "type": "n8n-nodes-pachca.pachca",
      "typeVersion": 2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "resource": "form",
        "operation": "create",
        "formTitle": "Заявка на отпуск",
        "triggerId": "={{ $json.trigger_id }}",
        "additionalFields": {
          "callbackId": "vacation_form",
          "submitText": "Отправить"
        },
        "formBuilderMode": "json",
        "formBlocks": "[{\"type\":\"date\",\"name\":\"date_from\",\"label\":\"Дата начала\",\"required\":true},{\"type\":\"date\",\"name\":\"date_to\",\"label\":\"Дата окончания\",\"required\":true},{\"type\":\"input\",\"name\":\"comment\",\"label\":\"Комментарий\",\"multiline\":true}]"
      },
      "name": "Форма заявки",
      "type": "n8n-nodes-pachca.pachca",
      "typeVersion": 2,
      "position": [480, 133]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "create",
        "entityId": {
          "__rl": true,
          "value": "CHAT_ID_HR",
          "mode": "id"
        },
        "content": "=**Заявка на отпуск** от <@{{ $json.user_id }}>\n\n**С:** {{ $json.data.date_from }}\n**По:** {{ $json.data.date_to }}\n**Комментарий:** {{ $json.data.comment || '—' }}",
        "buttonLayout": "single_row",
        "buttons": {
          "button": [
            {
              "text": "Согласовать",
              "type": "data",
              "data": "=vacation_decision:approve:{{ $json.user_id }}"
            },
            {
              "text": "Отклонить",
              "type": "data",
              "data": "=vacation_decision:reject:{{ $json.user_id }}"
            }
          ]
        }
      },
      "name": "Заявка руководителю",
      "type": "n8n-nodes-pachca.pachca",
      "typeVersion": 2,
      "position": [480, 266]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "update",
        "id": "={{ $json.message_id }}",
        "buttonLayout": "raw_json",
        "rawJsonButtons": "[]"
      },
      "name": "Убрать кнопки",
      "type": "n8n-nodes-pachca.pachca",
      "typeVersion": 2,
      "position": [480, 400]
    },
    {
      "parameters": {
        "resource": "thread",
        "operation": "create",
        "threadMessageId": "={{ $('Pachca Trigger').item.json.message_id }}"
      },
      "name": "Тред к заявке",
      "type": "n8n-nodes-pachca.pachca",
      "typeVersion": 2,
      "position": [720, 400]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "create",
        "entityType": "thread",
        "entityId": {
          "__rl": true,
          "value": "={{ $json.id }}",
          "mode": "id"
        },
        "content": "={{ $('Pachca Trigger').item.json.data.split(':')[1] === 'approve' ? 'Согласовано' : 'Отклонено' }}, решение: <@{{ $('Pachca Trigger').item.json.user_id }}>"
      },
      "name": "Решение в тред",
      "type": "n8n-nodes-pachca.pachca",
      "typeVersion": 2,
      "position": [960, 400]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "create",
        "entityType": "user",
        "entityId": {
          "__rl": true,
          "value": "={{ $('Pachca Trigger').item.json.data.split(':')[2] }}",
          "mode": "id"
        },
        "content": "={{ $('Pachca Trigger').item.json.data.split(':')[1] === 'approve' ? 'Ваша заявка на отпуск согласована' : 'Ваша заявка на отпуск отклонена' }}"
      },
      "name": "Ответ сотруднику",
      "type": "n8n-nodes-pachca.pachca",
      "typeVersion": 2,
      "position": [1200, 400]
    }
