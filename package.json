{
  "name": "pachca-api",
  "private": true,
  "packageManager": "bun@1.3.4",
  "scripts": {
    "sdk:build": "bash scripts/build-sdks.sh",
    "check:changelog": "node scripts/check-changelog-sync.mjs",
    "check:generated": "node scripts/check-generated-sync.mjs",
    "check:docs-format": "prettier --check --config apps/docs/prettier.config.mjs \"docs/**/*.md\" \"integrations/**/*.md\"",
    "format:docs": "prettier --write --config apps/docs/prettier.config.mjs \"docs/**/*.md\" \"integrations/**/*.md\"",
    "check:markdown": "markdownlint-cli2 \"docs/**/*.md\" \"integrations/**/*.md\" \"!**/node_modules/**\" \"!integrations/n8n/e2e/**\""
  },
  "workspaces": [
    "apps/*",
    "apps/*/*",
    "packages/*",
    "sdk/*",
    "integrations/*"
  ],
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "markdownlint-cli2": "^0.23.1",
    "prettier": "3.8.1",
    "turbo": "^2.8.1"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver",
    "vue-demi"
  ],
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8"
  }
}
