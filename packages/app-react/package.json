{
  "name": "@pachca/app-react",
  "version": "0.0.0",
  "description": "React-хуки приложений Пачки поверх window.pachca, который подставляет платформа",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && vitest run"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "dependencies": {
    "@pachca/app-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^3.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pachca/openapi",
    "directory": "packages/app-react"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
