{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "strict": true, "noEmit": true,
    "skipLibCheck": true, "lib": ["ES2022", "DOM", "DOM.Iterable"], "allowImportingTsExtensions": true,
    "jsx": "react-jsx", "types": ["vite/client"]
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts"],
  "exclude": ["dist", "node_modules"]
}
