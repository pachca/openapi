{
  "Client_Init": {
    "usage": "client := pachca.NewPachcaClient(\"YOUR_TOKEN\")\nctx := context.Background()",
    "imports": [
      "PachcaClient"
    ]
  },
  "TaskOperations_getTask": {
    "usage": "response, err := client.Tasks.GetTask(ctx, int32(123), int32(123))",
    "output": "Task{ID: int32, Title: string, IsDone: *bool}"
  },
  "TaskOperations_updateTask": {
    "usage": "request := pachca.TaskUpdateRequest{\n\tTask: pachca.TaskUpdateRequestTask{\n\t\tTitle: pachca.Ptr(\"example\"),\n\t\tIsDone: pachca.Ptr(true),\n\t},\n}\nresponse, err := client.Tasks.UpdateTask(ctx, int32(123), int32(123), request)",
    "output": "Task{ID: int32, Title: string, IsDone: *bool}",
    "imports": [
      "TaskUpdateRequest",
      "TaskUpdateRequestTask"
    ]
  },
  "TaskOperations_deleteComment": {
    "usage": "client.Tasks.DeleteComment(ctx, int32(123), int32(123), int32(123))"
  }
}
